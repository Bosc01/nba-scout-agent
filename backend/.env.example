# Required: Claude API key for the scout agent
ANTHROPIC_API_KEY=your_key_here

# Optional: PostHog analytics (report_generated events). Silently off when empty.
POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# Optional: Redis report cache, 24h TTL (e.g. an Upstash rediss:// URL).
# Cache falls back to Supabase + in-memory when empty.
REDIS_URL=

# Optional: Supabase persistent report cache + search history.
# Run backend/db/migrations/001_search_history.sql in the Supabase SQL editor.
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
